# ============================================================
# .env.example — Template for your environment variables
# ============================================================
# HOW TO USE:
#   1. Copy this file and rename it to ".env"
#   2. Fill in your actual API keys
#   3. Never commit the ".env" file to git
# ============================================================

# --- Google Gemini API Key ---
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# --- Application Settings ---
APP_TITLE=Indian Stock Market Agentic AI
APP_VERSION=1.0.0

# --- LLM Model Settings ---
GEMINI_MODEL=gemini-1.5-flash        # Model to use (flash = faster + cheaper)
GEMINI_TEMPERATURE=0.3               # 0 = deterministic, 1 = creative (0.3 is good for finance)
GEMINI_MAX_TOKENS=4096               # Maximum tokens in Gemini's response

# --- Market Data Settings ---
# How many days of historical data to fetch by default
DEFAULT_HISTORY_DAYS=90

# --- News Settings ---
# Maximum number of news articles to analyse per stock
MAX_NEWS_ARTICLES=10

# --- Report Settings ---
# Directory where generated reports will be saved
REPORT_OUTPUT_DIR=reports/
